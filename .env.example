# AI Growth 环境配置（复制为 .env 使用；全部有默认值，可不配置）

# 数据目录（DB / passport / 日志）
AI_GROWTH_DATA_DIR=~/.ai-growth

# 本地时区（用于自然日判断；默认取系统时区，如 Asia/Shanghai）
AI_GROWTH_TZ=Asia/Shanghai

# MCP / daemon 日志级别: debug | info | warn | error
AI_GROWTH_LOG_LEVEL=info

# Web UI 端口
AI_GROWTH_API_PORT=4580

# Passport 同步适配器: local-json（V1 默认，只写本地 JSON 文件）
AI_GROWTH_PASSPORT_ADAPTER=local-json

# Passport 本地 JSON 输出文件（相对 DATA_DIR）
AI_GROWTH_PASSPORT_FILE=passport.json
